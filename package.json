{
  "name": "turborilla",
  "version": "1.0.0",
  "description": "Unofficial typed API wrapper for Turborilla games (Mad Skills Motocross 2, Mad Skills BMX 2): backend endpoints and the assets CDN.",
  "keywords": [
    "api",
    "bmx",
    "mad skills",
    "madskillsmx",
    "motocross",
    "turborilla",
    "typescript",
    "wrapper"
  ],
  "homepage": "https://github.com/47PADO47/madskillsmx#readme",
  "bugs": {
    "url": "https://github.com/47PADO47/madskillsmx/issues"
  },
  "license": "ISC",
  "author": "PADO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/47PADO47/madskillsmx.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./mx2": {
      "types": "./dist/games/mx2.d.mts",
      "import": "./dist/games/mx2.mjs"
    },
    "./bmx2": {
      "types": "./dist/games/bmx2.d.mts",
      "import": "./dist/games/bmx2.mjs"
    },
    "./assets": {
      "types": "./dist/assets.d.mts",
      "import": "./dist/assets.mjs"
    }
  },
  "scripts": {
    "test": "bun test",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@padosoft/config": "^1.4.1",
    "@padosoft/logger": "^2.2.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^20.3.1",
    "husky": "^9.1.7",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "ultracite": "^7.11.1"
  },
  "peerDependencies": {
    "@padosoft/logger": "^2.2.0"
  },
  "peerDependenciesMeta": {
    "@padosoft/logger": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
