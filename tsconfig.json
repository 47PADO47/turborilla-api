{
  "extends": "@padosoft/config/typescript/base-ts7",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@/types/*": ["./src/types/*"],
      "@/core/*": ["./src/core/*"]
    },
    "composite": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"]
}
