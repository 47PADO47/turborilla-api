# Credentials and identifiers for the example scripts in scripts/.
# Copy to .env (git-ignored) and fill in your own values.

# Which game to target: mx2 | mx3 | bmx2
MADSKILLS_GAME=bmx2

# The account/user id to read or write.
MADSKILLS_USER_ID=

# Account password. Required for private profile sections and any write
# (setUserData / update-user-data.ts).
MADSKILLS_PASSWORD=

# Device install id used to build the wallet's newRealMoneyPurchases stub on
# update-user-data.ts. Only needed when uploading a wallet.
MADSKILLS_INSTALL_ID=
